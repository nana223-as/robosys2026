import sys

colors = {"gold":-1,"silver":-2,"black":0,"brown":1,
          "red":2,"orange":3,"yellow":4,"green":5,
          "blue":6,"violet":7,"gray":8,"white":9}

tolerance = {"gray":0.05,"violet":0.1,"blue":0.25,"green":0.5,
             "brown":1,"red":2,"gold":5,"silver":10}

count = 0

for line in sys.stdin:
    count += 1
    color = line.split()

    try:
        if len(color) !=4:
           raise ValueError

        a = colors[color[0]]
        b = colors[color[1]]
        c = colors[color[2]]
        e = tolerance[color[3]]

        if a <= 0 or b < 0:
           raise ValueError

        d = round((a*10 + b)* 10**c,2)
        print(d,e)

    except (KeyError,ValueError):
        print("Error",file=sys.stderr)
        sys.exit(1)

if count == 0:
        print("Error",file = sys.stderr)
        sys.exit(1)
